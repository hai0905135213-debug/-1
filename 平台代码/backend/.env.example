# 在 backend 目录使用 node --env-file=.env src/server.js 启动
PORT=3001
HOST=127.0.0.1
ENABLE_DEV_LOGIN=false
ENABLE_TIMETABLE_PROXY=false
SEED_DEMO=false
# 登录后在本地数据库确认用户编号，由运营指定管理员；不能通过客户端自助注册管理员。
ADMIN_USER_IDS=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 对外试运行前填写实际运营主体和可联系的支持方式（公开展示，不填密钥）
PUBLIC_OPERATOR_NAME=
PUBLIC_SUPPORT_CONTACT=
# 可选绝对路径
# DATA_DIR=/absolute/business-data
# RESTAURANT_DB_PATH=/absolute/restaurants.db
